# 기동 시 ${DOMAIN}만 치환된다. $host 등 nginx 변수는 NGINX_ENVSUBST_FILTER가 보호한다.

upstream backend_was {
    server backend:8080;
    keepalive 32;
}

# 백엔드에 넘길 원래 요청의 스킴. TLS는 Cloudflare가 끝내고 cloudflared가 이 80 포트로 평문을 넘기므로
# $scheme 은 늘 http 다. 그대로 넘기면 백엔드가 요청을 HTTP로 보고 XSRF-TOKEN 쿠키에 Secure를 붙이지 않는다
# (application-prod.yml forward-headers-strategy). Cloudflare가 붙인 X-Forwarded-Proto 를 그대로 쓰고,
# 헤더 없이 들어온 요청(내부 확인용 curl 등)만 $scheme 으로 둔다.
map $http_x_forwarded_proto $thorp_forwarded_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

# 정적 프론트 + /api 리버스 프록시. 앞단은 Cloudflare Tunnel(compose 의 cloudflared)이다.
# 호스트에 포트를 열지 않으므로 이 서버에 닿는 것은 같은 Docker 네트워크의 컨테이너뿐이다.
server {
    listen 80;
    server_name ${DOMAIN};

    # 사용자의 실제 IP. 모든 요청이 cloudflared 컨테이너에서 오므로 $remote_addr 은 늘 그 주소다.
    # Cloudflare가 붙이는 CF-Connecting-IP 로 바꿔 둔다 — 화면 도우미의 IP 한도가 이 값을 키로 쓴다.
    # 사설 대역만 믿는 것은 이 서버에 닿을 수 있는 곳이 Docker 네트워크뿐이기 때문이다.
    set_real_ip_from 10.0.0.0/8;
    set_real_ip_from 172.16.0.0/12;
    set_real_ip_from 192.168.0.0/16;
    real_ip_header   CF-Connecting-IP;

    client_max_body_size 20m;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    location /api/ {
        # 끝의 슬래시가 /api 접두사를 떼어낸다. 없으면 /api/backtests 가 그대로
        # 전달되어 백엔드(/backtests)가 못 받는다. 지우지 말 것.
        proxy_pass http://backend_was/;
        proxy_http_version 1.1;
        proxy_set_header Connection        "";
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        # $proxy_add_x_forwarded_for 를 쓰지 않는다. 그것은 사용자가 보낸 X-Forwarded-For 뒤에 덧붙이고,
        # 백엔드(forward-headers-strategy: framework)는 맨 앞 값을 IP로 읽으므로 사용자가 IP를 꾸밀 수 있다.
        # 위 real_ip 설정으로 $remote_addr 이 이미 실제 IP라 그 값 하나만 넘긴다.
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Forwarded-Proto $thorp_forwarded_proto;
        # 백테스트 조회가 길어질 수 있어 기본 60s보다 넉넉히 준다
        proxy_connect_timeout 10s;
        proxy_read_timeout    300s;
        proxy_send_timeout    300s;
        # 진행 시계열 구독(GET /api/results/{token}/progress)이 SSE 라서 버퍼링을 끈다.
        # 기본값(on)이면 nginx 가 응답을 모아 두었다가 한꺼번에 내보내므로, 로컬에서 하루씩
        # 자라던 그래프가 배포 환경에서는 실행이 끝날 때까지 멈춰 있는다. 지우지 말 것.
        proxy_buffering off;
        # 중간 프록시가 다시 버퍼링하지 않도록 백엔드가 보내는 X-Accel-Buffering 을 살려 둔다.
        proxy_cache off;
    }

    # GitLab이 Jenkins 배포 Job을 호출하는 Webhook 엔드포인트만 공개한다.
    # /jenkins/ 이하의 UI·API는 프록시하지 않으므로 기존 SSH 터널 접근 정책은 유지된다.
    location ^~ /jenkins/project/ {
        limit_except POST {
            deny all;
        }

        # Jenkins 컨테이너가 잠시 재시작 중이어도 nginx 설정 로드는 성공해야 한다.
        resolver 127.0.0.11 ipv6=off valid=30s;
        set $jenkins_webhook http://thorp-jenkins:8080;

        # 외부 전용 /jenkins 접두사를 제거해 GitLab Plugin의 /project/...로 전달한다.
        rewrite ^/jenkins(/project/.*)$ $1 break;
        proxy_pass $jenkins_webhook;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout    30s;
        proxy_send_timeout    30s;
    }

    root /usr/share/nginx/html;
    index index.html;

    # 파일명에 해시가 붙어 있어 장기 캐시가 안전하다
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # SPA 라우팅
    location / {
        try_files $uri $uri/ /index.html;
    }
}
