# cp .env.prod.example .env.prod 로 복사해 사용한다. .env.prod는 커밋하지 않는다.

# --- 도메인 / 인증서 ---
DOMAIN=j15e205.p.ssafy.io
# Let's Encrypt 만료 알림 수신 주소 (팀 대표 메일)
CERTBOT_EMAIL=

# --- PostgreSQL ---
POSTGRES_DB=thorp
POSTGRES_USER=thorp
# 반드시 바꾼다. 예: openssl rand -base64 24
POSTGRES_PASSWORD=
# 워커의 시장 자료 읽기 전용 계정(spec 004 R-09). 비우면 위 일반 계정을 쓴다.
# 읽기 전용 role은 spec 004 T003 마이그레이션이 만든다. 그 뒤에 채운다.
MARKET_DATA_USER=
MARKET_DATA_PASSWORD=

# --- RabbitMQ (Job 전달의 주 경로) ---
RABBITMQ_USER=thorp
# 반드시 바꾼다. 예: openssl rand -base64 24
RABBITMQ_PASSWORD=
BACKTEST_JOB_QUEUE=backtest.jobs

# --- Kafka (설치만. 현재 사용하지 않음) ---
BACKTEST_JOB_TOPIC=backtest.jobs

# --- 시장·거시 지표 외부 API ---
# 실제 키는 서버의 .env.prod에만 저장하고 Git에 커밋하지 않는다.
KRX_API_KEY=
ECOS_API_KEY=
# 발급 키 끝의 =를 포함한 전체 값을 입력한다.
KOSIS_API_KEY=
# 관세청 수출입총괄(GW)의 일반 인증키(Decoding)를 입력한다.
DATA_GO_KR_SERVICE_KEY=

# --- Worker ---
# 4 vCPU 기준 두 값의 합 2개가 상한선. 병목은 CPU다.
# 합 × prefetch(1) = 백테스트 동시 실행 상한(spec 004 R-19). 백엔드 설정에는 동시 실행 상한이 없다.
# SINGLE 은 단건 큐(backtest.jobs)만 push 로 받는 단건 전용, FLEX 는 벌크 큐(backtest.jobs.bulk)를 먼저
# 보고 비어 있으면 단건을 집는 공용이다(spec 004 R-20). 벌크가 있으면 최소 SINGLE 만큼은 단건에 남는다.
WORKER_SINGLE_REPLICAS=1
WORKER_FLEX_REPLICAS=1

# --- 디스크 ---
# Parquet/원본 데이터·백업 경로. 현재 서버는 320GiB 볼륨 하나뿐이라
# 별도 마운트 없이 루트 디스크의 디렉토리다.
DATA_DIR=/data

# --- 배포 ---
# 서버의 레포 경로. Jenkins 컨테이너에 반드시 동일 경로로 마운트한다.
DEPLOY_DIR=/home/ubuntu/S15P21E205
# 호스트의 docker 그룹 GID. Jenkins가 docker.sock에 접근하는 데 쓴다.
#   getent group docker | cut -d: -f3
DOCKER_GID=988

# 백테스트 실행 한도(spec 004 T014, FR-006). 백엔드는 이 값들이 없으면 기동하지 않는다 —
# "상한을 정하기 전에 무제한 실행을 허용하지 않는다"를 설정 누락으로 우회할 수 없게 한 것이다.
#
# 아래 수는 PD-06 확정 전의 임시값이다. 확정되면 값을 바꾸고 PROVISIONAL 을 false 로 내린다
# (그 전까지 429 응답에 임시값임이 실린다). 근거 자료는 T012 집계 뷰다.
#
# 두 값 모두 단건(SINGLE) 큐만 센다(spec 004 R-20). 탐색·경제환경 파생 실행은 backtest.jobs.bulk 로
# 가고 이 한도의 대상이 아니다 — 그쪽 적재량은 dispatch-window 와 WORKER_FLEX_REPLICAS 가 정한다.
THORP_LIMIT_MAX_QUEUED_PER_USER=5
THORP_LIMIT_MAX_QUEUED_TOTAL=50
# 로그인하지 않은 요청 전부가 나눠 쓰는 단건 대기 몫(spec 005 B01). MAX_QUEUED_TOTAL 보다 작게 둔다.
THORP_LIMIT_MAX_QUEUED_ANONYMOUS=10
THORP_LIMIT_MAX_RUN_SECONDS=1800
THORP_LIMIT_STALE_RUN_SECONDS=300
THORP_LIMIT_CANCEL_GRACE_SECONDS=120
THORP_LIMIT_PROVISIONAL=true

# 결과 공개 열람(spec 005 T004). 백엔드는 이 값들이 없으면 기동하지 않는다.
# 유효 시간(PD-23)과 거래 내역 페이지 상한(R-11)은 팀 확정 전 임시값이다. 기간은 ISO-8601(P7D·PT10M) 형식이다.
# TTL 은 로그인하지 않고 낸 분석의 결과 주소가 열려 있는 시간이다 — 로그인 사용자의 결과는 만료되지 않는다.
THORP_RESULT_PUBLIC_TOKEN_TTL=P7D
THORP_RESULT_EXPIRY_SWEEP_INTERVAL=PT10M
THORP_RESULT_EXPIRY_SWEEP_BATCH_SIZE=100
THORP_RESULT_TRADES_PAGE_SIZE=100

# 배우기 관리 계정 허용 목록(spec 013). 쉼표로 구분한 사용자 ID(users.id)다. 예: 12,34
# 비우면 관리자가 없어 /admin/learning 경로가 모두 404 다. 목록의 계정만 글을 저장·게시·게시 취소한다.
THORP_LEARNING_ADMIN_USER_IDS=

# 운영자 측정 조회(GET /internal/execution-metrics, spec 004 T012)의 X-Ops-Token 값. 로그인(spec 014)이 붙기
# 전까지의 임시 문이다. 비우면 그 경로는 404 로 닫힌다. 예: openssl rand -base64 24
THORP_OPS_TOKEN=
