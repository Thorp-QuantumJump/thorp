# 운영 서버(EC2)용 환경변수. 복사해서 사용한다.
#   cp .env.prod.example .env.prod
# .env.prod는 절대 커밋하지 않는다 (.gitignore에 등록되어 있음).

# --- 도메인 / 인증서 ---
# SSAFY에서 발급받은 도메인. nginx 설정과 certbot 발급에 함께 쓰인다.
DOMAIN=j15e205.p.ssafy.io
# Let's Encrypt 만료 알림을 받을 주소 (팀 대표 메일)
CERTBOT_EMAIL=

# --- PostgreSQL ---
POSTGRES_DB=quantumjump
POSTGRES_USER=quantum
# 반드시 바꾼다. 예: openssl rand -base64 24
POSTGRES_PASSWORD=

# --- RabbitMQ (백테스트 Job 전달의 주 경로) ---
RABBITMQ_USER=quantum
# 반드시 바꾼다. 예: openssl rand -base64 24
RABBITMQ_PASSWORD=
BACKTEST_JOB_QUEUE=backtest.jobs

# --- Kafka (설치만. 현재 사용하지 않음) ---
# 나중에 Kafka로 전환하거나 병행할 때 사용한다.
BACKTEST_JOB_TOPIC=backtest.jobs

# --- Worker ---
# 4 vCPU 기준 2개가 상한선.
# RabbitMQ는 하나의 큐를 여러 소비자가 나눠 가지므로(competing consumers)
# Kafka 파티션 같은 개수 제약이 없다. 병목은 CPU다.
WORKER_REPLICAS=2

# --- 디스크 ---
# Parquet/원본 데이터·백업이 쌓이는 경로.
# 현재 서버에는 320GiB EBS 루트 볼륨 하나뿐이라 /data는 그냥 루트 디스크의 디렉토리다.
# (사양표의 6TB HDD는 실제로 붙어 있지 않다. t3 계열은 인스턴스 스토어 미지원)
# 나중에 EBS 볼륨을 추가로 붙이면 이 경로에 마운트하면 되고, 설정은 그대로 둔다.
DATA_DIR=/data

# --- 배포 ---
# 서버에 레포를 클론한 경로. Jenkins 컨테이너에 동일 경로로 마운트한다.
DEPLOY_DIR=/home/ubuntu/S15P21E205
