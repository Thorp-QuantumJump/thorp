# cp .env.prod.example .env.prod 로 복사해 사용한다. .env.prod는 커밋하지 않는다.

# --- 도메인 / 인증서 ---
DOMAIN=j15e205.p.ssafy.io
# Let's Encrypt 만료 알림 수신 주소 (팀 대표 메일)
CERTBOT_EMAIL=

# --- PostgreSQL ---
POSTGRES_DB=quantumjump
POSTGRES_USER=quantum
# 반드시 바꾼다. 예: openssl rand -base64 24
POSTGRES_PASSWORD=

# --- RabbitMQ (Job 전달의 주 경로) ---
RABBITMQ_USER=quantum
# 반드시 바꾼다. 예: openssl rand -base64 24
RABBITMQ_PASSWORD=
BACKTEST_JOB_QUEUE=backtest.jobs

# --- Kafka (설치만. 현재 사용하지 않음) ---
BACKTEST_JOB_TOPIC=backtest.jobs

# --- Worker ---
# 4 vCPU 기준 2개가 상한선. 병목은 CPU다.
WORKER_REPLICAS=2

# --- 디스크 ---
# Parquet/원본 데이터·백업 경로. 현재 서버는 320GiB 볼륨 하나뿐이라
# 별도 마운트 없이 루트 디스크의 디렉토리다.
DATA_DIR=/data

# --- 배포 ---
# 서버의 레포 경로. Jenkins 컨테이너에 반드시 동일 경로로 마운트한다.
DEPLOY_DIR=/home/ubuntu/S15P21E205
# 호스트의 docker 그룹 GID. Jenkins가 docker.sock에 접근하는 데 쓴다.
#   getent group docker | cut -d: -f3
DOCKER_GID=988
