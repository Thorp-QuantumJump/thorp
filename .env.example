# 복사해서 .env로 사용: cp .env.example .env
# .env는 절대 커밋하지 않는다.

# --- PostgreSQL ---
POSTGRES_DB=quantumjump
POSTGRES_USER=quantum
POSTGRES_PASSWORD=quantum

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
BACKTEST_JOB_TOPIC=backtest.jobs

# --- KRX / 외부 데이터 API ---
# data/ 파이프라인에서 사용. 발급받은 키를 넣는다.
KRX_API_KEY=
