# data 파트 로컬 실행용 환경 변수. 복사해서 .env로 쓴다: cp .env.example .env
# .env는 절대 커밋하지 않는다. 실제 키·비밀번호는 이 파일에 적지 않는다.

# --- KRX OPEN API (유일한 개발·검증 원천, 원칙 X) ---
# 인증키. 서비스(ETF 일별매매정보 등)별 활용 승인 후 발급된다. 루트 .env.example과 같은 이름이다.
KRX_API_KEY=

# --- 서비스 저장소 (raw → processed → PostgreSQL 적재의 마지막 단계) ---
# 아래 thorp/thorp는 로컬 개발용 예시 계정이다. 운영 계정은 서버에서만 만들고 저장소에 남기지 않는다.
# 컨테이너 안에서 실행할 때는 호스트를 localhost 대신 postgres로 바꾼다(docker-compose.dev.yml과 같은 형식).
DATABASE_URL=postgresql://thorp:thorp@localhost:5432/thorp

# --- 경제지표 원천 (spec 008) ---
# 세 키 모두 루트 .env.example과 같은 이름이다. 값은 여기에 적지 않는다.
# 키가 없으면 수집은 못 하지만 테스트는 돈다 — tests/fixtures/macro/의 저장된 응답만 읽기 때문이다.

# 한국은행 경제통계시스템. 국고채 3년·원/달러 환율·두바이유.
# 끝의 =를 포함한 발급 키 전체를 입력한다. 임의로 URL 인코딩하지 않는다.
# 이용기간은 발급일로부터 2년이다. 만료 전에 다시 확인한다(FR-018a).
ECOS_API_KEY=
# 국가통계포털. 생산·소비·투자·노동·물가 등 10개 표. 분당 200회·요청당 40,000셀 한도(FR-017).
KOSIS_API_KEY=
# 관세청 수출입총괄(GW) 활용신청 후 발급받은 일반 인증키(Decoding). 조회 기간 1년 제한(FR-017a).
DATA_GO_KR_SERVICE_KEY=
