      <link>https://rss.example.co.kr/economy/2001</link>
    </item>
    <item>
      <title>링크가 없고 guid만 있는 기사</title>
      <guid isPermaLink="false">example-2002</guid>
      <pubDate>Thu, 10 Sep 2026 12:00:00 +0900</pubDate>
    </item>
    <item>
