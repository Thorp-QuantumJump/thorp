{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thorp.ssafy/contracts/backtest-timeseries.schema.json",
  "title": "BacktestTimeseries",
  "description": "GET /backtests/{backtestId}/timeseries 응답의 data. ApiResponse 래퍼 안에 들어간다. COMPLETED가 아니면 409 RESULT_NOT_READY.",
  "type": "object",
  "additionalProperties": false,
  "required": ["backtestId", "points"],
  "properties": {
    "backtestId": { "type": "integer" },
    "points": {
      "type": "array",
      "minItems": 1,
      "description": "날짜 오름차순. 첫 equity = summary.initialEquity, 마지막 equity = summary.finalEquity",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["date", "equity", "cumulativeReturn", "drawdown"],
        "properties": {
          "date": { "type": "string", "format": "date" },
          "equity": { "type": "integer", "minimum": 0, "description": "종가 기준 총 자산(KRW)" },
          "cumulativeReturn": { "type": "number", "description": "equity / points[0].equity - 1" },
          "drawdown": { "type": "number", "maximum": 0, "description": "equity / max(equity[0..t]) - 1" }
        }
      }
    }
  }
}
