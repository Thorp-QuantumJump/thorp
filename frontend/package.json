{
  "name": "thorp-frontend",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build --configLoader runner",
    "lint": "eslint .",
    "test": "npm run test:dom && npm run test:legacy",
    "test:dom": "vitest run --configLoader runner",
    "test:legacy": "node --test src/api/market.test.ts src/utils/indicatorHistory.test.ts src/utils/marketComparison.test.ts src/utils/marketFormat.test.ts",
